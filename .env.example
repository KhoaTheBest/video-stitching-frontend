# Copy to .env.local for development. Never commit real values.
# All VITE_* values are public: they are compiled into the browser bundle.

# Display prices on the pricing page (e.g. "$9"). Leave empty to show "Coming soon".
VITE_PRICE_MONTHLY=
VITE_PRICE_YEARLY=
VITE_PRICE_LIFETIME=

# Lemon Squeezy checkout links (Products > Share). Use TEST MODE links until launch.
VITE_LS_CHECKOUT_MONTHLY=
VITE_LS_CHECKOUT_YEARLY=
VITE_LS_CHECKOUT_LIFETIME=

# Shown on the legal and pricing pages.
VITE_SUPPORT_EMAIL=

# Cloudflare Web Analytics (cookieless). Leave empty to turn analytics off.
# Dashboard > Analytics & Logs > Web Analytics > Add a site > copy the token from the JS snippet.
# If the site is a Pages project you can instead enable Web Analytics on the project and leave this empty,
# so the beacon is not loaded twice.
VITE_CF_ANALYTICS_TOKEN=

# --- Server side: set these in the Cloudflare Pages project, not here. ---
# Used by functions/api/license.ts. The License API needs no API key.
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_PRODUCT_IDS=   # comma-separated product ids that grant Pro
